{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "111-social-autopilot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 10 * * 1,3,5", "*/15 * * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "111-social",
      "database_id": "cd5f68a7-f737-4d52-b044-c097cc25cfba"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "111-social-media"
    }
  ],
  "vars": {
    "MEDIA_PUBLIC_BASE_URL": "https://111-social-autopilot.sunmedia.workers.dev"
  }
}
