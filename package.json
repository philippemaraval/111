{
  "name": "marseille-111",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cf": "opennextjs-cloudflare build && node scripts/patch-opennext-cloudflare.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "optimize:images": "node scripts/optimize-product-images.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "wrangler": "^4.131.0"
  }
}
